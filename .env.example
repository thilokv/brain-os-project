# Copy this file to .env and fill in real values.
# Brain OS runs fully without any of these set -- Anthropic and Slack
# integrations degrade gracefully to deterministic local behavior when
# their keys are absent (see app/services/executive_briefing.py and
# app/services/notification_service.py).

APP_NAME="Brain OS Enterprise Workflow Platform"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Risk engine
AUTO_APPROVE_THRESHOLD=5000.0

# SQLite storage (created automatically on startup)
DATABASE_PATH=data/brain_os.db
CHECKPOINT_DB_PATH=data/checkpoints.db

# ChromaDB vector memory
CHROMA_PERSIST_PATH=data/chroma
CHROMA_COLLECTION_NAME=invoice_memory
DUPLICATE_SIMILARITY_THRESHOLD=0.92

# Anthropic (used to generate the natural-language executive briefing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Slack (used to notify approvers when a workflow pauses for human review)
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=
