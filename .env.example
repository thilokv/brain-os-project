# Copy this file to .env and fill in real values.
# Anthropic and Slack integrations degrade gracefully to deterministic
# local behavior when their keys are absent (see
# app/services/executive_briefing.py and app/services/notification_service.py).
# BRAIN_OS_API_TOKEN is different: it is required. All /brain-os/*
# endpoints reject every request with 401 until it is set to a real
# value -- there is no "auth disabled" fallback. See README.md.

APP_NAME="Brain OS Enterprise Workflow Platform"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Risk engine
AUTO_APPROVE_THRESHOLD=5000.0

# SQLite storage (created automatically on startup)
DATABASE_PATH=data/brain_os.db
CHECKPOINT_DB_PATH=data/checkpoints.db

# ChromaDB vector memory
CHROMA_PERSIST_PATH=data/chroma
CHROMA_COLLECTION_NAME=invoice_memory
DUPLICATE_SIMILARITY_THRESHOLD=0.92

# Anthropic (used to generate the natural-language executive briefing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Slack (used to notify approvers when a workflow pauses for human review)
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=

# API authentication -- REQUIRED. Every /brain-os/* endpoint checks for
# "Authorization: Bearer <this value>". GET /health stays public (no
# token needed) for container health checks.
# This is a placeholder, not a real credential -- generate your own
# (e.g. `openssl rand -hex 32`) and set it via your secret manager in
# any shared/deployed environment. Never commit the real value.
BRAIN_OS_API_TOKEN=change-me-in-production
